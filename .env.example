# Copy this file to .env at the repository root. This is the only server configuration file.
# Terminal commands load it with: uv run --locked --env-file ../.env ...
# Docker commands from the root use: docker compose --env-file .env -f research-backend/compose.dev.yaml ...

# Database credentials: choose distinct URL-safe random values. Keep existing values when reusing volumes.
# Each service automatically selects its own restricted role; migrations use POSTGRES_PASSWORD.
POSTGRES_PASSWORD=replace-with-random-database-owner-password
BACKEND_DB_PASSWORD=replace-with-random-backend-password
WORKER_DB_PASSWORD=replace-with-random-worker-password
AGENT_DB_PASSWORD=replace-with-random-agent-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=research
REDIS_PORT=6379

# Shared application secrets: choose two distinct random values, at least 32 characters each.
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SECRET=replace-with-another-32-random-characters
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
AGENT_URL=http://127.0.0.1:8001
# Both service directories resolve this to the same folder. Absolute paths also work.
STORAGE_ROOT=../storage-dev

# OpenAI is the only chat/vision provider. Set your API key (API billing is separate from ChatGPT).
OPENAI_API_KEY=
ANSWER_MODEL=gpt-5.4-mini
VISION_MODEL=gpt-5.4-mini
# Use low reasoning for answers and no reasoning tokens for image transcription.
# Leave an effort blank only when selecting an OpenAI model that does not support reasoning_effort.
ANSWER_REASONING_EFFORT=low
VISION_REASONING_EFFORT=none
VISION_TIMEOUT_SECONDS=120
VISION_MAX_TOKENS=4096
# Retry output-truncated crops as overlapping sections (bounded per original region).
VISION_SPLIT_MAX_DEPTH=3
VISION_SPLIT_MIN_SIDE=192
VISION_SPLIT_OVERLAP=0.08
# Optional pacing: 60 spaces vision calls by a minute for small quotas.
VISION_MIN_INTERVAL_SECONDS=0

# Embeddings remain local; OpenAI is used only for chat, vision and optional judging.
OLLAMA_BASE_URL=http://localhost:11434
# Full Docker application containers reach the host using this separate URL.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=4
RETRIEVAL_MODE=hybrid

# Optional OpenAI evaluation judge; blank inherits the answer model and effort.
JUDGE_MODEL=
# Tracing can contain paper excerpts. Enable only when intended.
TRACE_DOCUMENT_CONTENT=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-assistant

# Optional pgAdmin login, separate from the application's admin login.
# Used only by the full Compose "admin" profile.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-random-pgadmin-password
