  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "type": "array",
            "title": "Blocks"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "answerability": {
            "type": "string",
            "enum": [
              "full",
              "partial",
              "none"
            ],
            "title": "Answerability"
          },
          "retrieved_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Retrieved Ids"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QueryUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "blocks",
          "citations",
          "answerability"
        ],
        "title": "Answer"
      },
      "Block": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "table",
              "image",
              "citation",
              "limitation"
            ],
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "default": ""
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "content_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Id"
          },
          "headers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headers"
          },
          "rows": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array",
            "title": "Rows"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "Block"
      },
      "Body_upload_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_documents_post"
      },
      "ChatInput": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "document_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Document Ids"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "question",
          "document_ids"
        ],
        "title": "ChatInput"
      },
      "Citation": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "bbox": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "document_id",
          "title",
          "version",
          "page",
          "source_url"
        ],
        "title": "Citation"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 6,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelUsage": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "service_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Tier"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "cached_input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cached Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "reasoning_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Reasoning Tokens",
            "default": 0
          },
          "estimated_cost_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Cost Usd"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model"
        ],
        "title": "ModelUsage"
      },
      "QueryUsage": {
        "properties": {
          "calls": {
            "items": {
              "$ref": "#/components/schemas/ModelUsage"
            },
            "type": "array",
            "title": "Calls"
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Input Tokens",
            "default": 0
          },
          "cached_input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cached Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Output Tokens",
            "default": 0
          },
          "reasoning_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Reasoning Tokens",
            "default": 0
          },
          "usage_complete": {
            "type": "boolean",
            "title": "Usage Complete"
          },
          "estimated_cost_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Cost Usd"
          },
          "known_cost_usd": {
            "type": "number",
            "minimum": 0.0,
            "title": "Known Cost Usd",
            "default": 0
          },
          "pricing_version": {
            "type": "string",
            "title": "Pricing Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "usage_complete",
          "pricing_version"
        ],
        "title": "QueryUsage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
